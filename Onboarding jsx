  ar: { name: "العربية", flag: "🇸🇦", welcome: "!مرحباً 🚀", subtitle: ".دقيقتان .استراتيجية", capital: "رأس المال؟", exp: "الخبرة؟", risk: "المخاطر؟", monitor: "هل يمكنك المراقبة؟", goals: "الأهداف؟", yes: "نعم", no: "لا", next: "التالي", back: "رجوع", start: "ابدأ", starting: "جاري البدء...", error: "خطأ", tryAgain: "حاول مرة أخرى" }
