const opts = {
  capital: [
    { v: '500', e: '🌱', l: '$500-$1K' },
    { v: '2500', e: '💪', l: '$1K-$5K' },
    { v: '7500', e: '🚀', l: '$5K-$10K' },
    { v: '15000', e: '💎', l: '$10K+' }
  ],
  exp: [
    { v: 'beginner', e: '🐣', en: 'Beginner', bg: 'Начинаещ', ru: 'Новичок', es: 'Principiante', fr: 'Débutant', de: 'Anfänger', pt: 'Iniciante', tr: 'Başlangıç', zh: '初学者', ar: 'مبتدئ' },
    { v: 'intermediate', e: '📈', en: 'Intermediate', bg: 'Среден', ru: 'Средний', es: 'Intermedio', fr: 'Intermédiaire', de: 'Fortgeschritten', pt: 'Intermediário', tr: 'Orta', zh: '中级', ar: 'متوسط' },
    { v: 'advanced', e: '🎯', en: 'Advanced', bg: 'Напреднал', ru: 'Продвинутый', es: 'Avanzado', fr: 'Avancé', de: 'Erfahren', pt: 'Avançado', tr: 'İleri', zh: '高级', ar: 'متقدم' },
    { v: 'expert', e: '👑', en: 'Expert', bg: 'Експерт', ru: 'Эксперт', es: 'Experto', fr: 'Expert', de: 'Experte', pt: 'Especialista', tr: 'Uzman', zh: '专家', ar: 'خبير' }
  ],
  risk: [
    { v: 'very_low', e: '🐢', en: 'Very Low', bg: 'Много нисък', ru: 'Очень низкий', es: 'Muy bajo', fr: 'Très bas', de: 'Sehr niedrig', pt: 'Muito baixo', tr: 'Çok düşük', zh: '非常低', ar: 'منخفض جداً' },
    { v: 'low', e: '🛡️', en: 'Low', bg: 'Нисък', ru: 'Низкий', es: 'Bajo', fr: 'Bas', de: 'Niedrig', pt: 'Baixo', tr: 'Düşük', zh: '低', ar: 'منخفض' },
    { v: 'medium', e: '⚖️', en: 'Medium', bg: 'Среден', ru: 'Средний', es: 'Medio', fr: 'Moyen', de: 'Mittel', pt: 'Médio', tr: 'Orta', zh: '中', ar: 'متوسط' },
    { v: 'high', e: '🔥', en: 'High', bg: 'Висок', ru: 'Высокий', es: 'Alto', fr: 'Élevé', de: 'Hoch', pt: 'Alto', tr: 'Yüksek', zh: '高', ar: 'عالي' }
  ],
  goals: [
    { v: 'income', e: '💰', en: 'Income', bg: 'Доход', ru: 'Доход', es: 'Ingresos', fr: 'Revenu', de: 'Einkommen', pt: 'Renda', tr: 'Gelir', zh: '收入', ar: 'دخل' },
    { v: 'growth', e: '📊', en: 'Growth', bg: 'Растеж', ru: 'Рост', es: 'Crecimiento', fr: 'Croissance', de: 'Wachstum', pt: 'Crescimento', tr: 'Büyüme', zh: '增长', ar: 'نمو' },
    { v: 'learning', e: '🎓', en: 'Learning', bg: 'Учене', ru: 'Обучение', es: 'Aprender', fr: 'Apprendre', de: 'Lernen', pt: 'Aprender', tr: 'Öğrenme', zh: '学习', ar: 'تعلم' },
    { v: 'passive', e: '😴', en: 'Passive', bg: 'Пасивен', ru: 'Пассивный', es: 'Pasivo', fr: 'Passif', de: 'Passiv', pt: 'Passivo', tr: 'Pasif', zh: '被动', ar: 'سلبي' }
  ]
};

export default function Onboarding({ userId, onComplete }) {
  const [lang, setLang] = useState('en');
  const [step, setStep] = useState(0);
  const [profile, setProfile] = useState({ 
    capital: '', 
    experience: '', 
    risk: '', 
    monitor: null, 
    goals: [] 
  });
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [result, setResult] = useState(null);

  const t = translations[lang];
  const steps = ['welcome', 'capital', 'exp', 'risk', 'monitor', 'goals', 'result'];

  const canNext = () => {
    if (step === 0) return true;
    if (step === 1) return profile.capital;
    if (step === 2) return profile.experience;
    if (step === 3) return profile.risk;
    if (step === 4) return profile.monitor !== null;
    if (step === 5) return profile.goals.length > 0;
    return true;
  };

  // Handle completion - API CALL
  const handleComplete = async () => {
    setLoading(true);
    setError(null);

    try {
      console.log('📤 Sending onboarding data to backend...');
      console.log('User ID:', userId);
      console.log('Profile:', profile);

      // Call API to complete onboarding
      const response = await api.completeOnboarding(userId, {
        capital: profile.capital,
        experience: profile.experience,
        risk_tolerance: profile.risk,
        can_monitor: profile.monitor,
        goals: profile.goals
      });

      console.log('✅ Backend response:', response);

      if (response.success) {
        setResult(response);
        
        // Notify parent component
        if (onComplete) {
          onComplete(response);
        }

        // Wait 2 seconds then redirect
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 2000);
      } else {
        setError(response.message || 'Failed to start strategy');
      }
    } catch (err) {
      console.error('❌ Onboarding error:', err);
      setError(err.message || 'Connection error. Please try again.');
    } finally {
      setLoading(false);
    }
  };

  // Show success screen
  if (result && result.success) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-green-100 to-blue-100 flex items-center justify-center p-4">
        <div className="bg-white rounded-2xl shadow-2xl p-8 max-w-md text-center">
          <CheckCircle className="w-20 h-20 text-green-500 mx-auto mb-4 animate-bounce" />
          <h2 className="text-3xl font-bold text-gray-800 mb-2">🎉 Success!</h2>
          <p className="text-gray-600 mb-4">
            <strong className="text-green-600">{result.strategy.toUpperCase()}</strong> strategy started!
          </p>
          <p className="text-sm text-gray-500">Redirecting to dashboard...</p>
          <div className="mt-4">
            <Loader className="w-6 h-6 text-blue-500 mx-auto animate-spin" />
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 to-purple-50 p-4">
      {/* Language Selector */}
      <div className="fixed top-4 right-4 z-50 bg-white rounded-lg shadow-lg p-2 flex items-center gap-2">
        <Globe className="w-5 h-5" />
        <select value={lang} onChange={(e) => setLang(e.target.value)} className="bg-transparent outline-none font-semibold">
          {Object.entries(translations).map(([k, v]) => (
            <option key={k} value={k}>{v.flag} {v.name}</option>
          ))}
        </select>
      </div>

      <div className="max-w-4xl mx-auto py-8">
        {/* Progress Bar */}
        <div className="mb-8">
          <div className="flex items-center justify-between mb-2">
            {steps.map((_, i) => (
              <React.Fragment key={i}>
                <div className={`w-10 h-10 rounded-full flex items-center justify-center transition-all ${i < step ? 'bg-green-500 text-white' : i === step ? 'bg-blue-500 text-white' : 'bg-gray-200'}`}>
                  {i < step ? <CheckCircle className="w-6 h-6" /> : <Circle className="w-6 h-6" />}
                </div>
                {i < steps.length - 1 && <div className={`flex-1 h-1 mx-2 transition-all ${i < step ? 'bg-green-500' : 'bg-gray-200'}`} />}
              </React.Fragment>
            ))}
          </div>
          <div className="text-center text-sm mt-2">{step + 1} / {steps.length}</div>
        </div>

        {/* Content */}
        <div className="bg-white rounded-2xl shadow-xl p-8 min-h-[500px]">
          {step === 0 && (
            <div className="text-center space-y-6">
              <TrendingUp className="w-16 h-16 text-blue-500 mx-auto" />
              <h2 className="text-3xl font-bold">{t.welcome}</h2>
              <p className="text-lg text-gray-600">{t.subtitle}</p>
            </div>
          )}

          {step === 1 && (
            <div className="space-y-6">
              <Target className="w-16 h-16 text-green-500 mx-auto" />
              <h2 className="text-2xl font-bold text-center">{t.capital}</h2>
              <div className="max-w-md mx-auto space-y-4">
                {opts.capital.map(o => (
                  <button key={o.v} onClick={() => setProfile({ ...profile, capital: o.v })} className={`w-full p-4 rounded-lg border-2 transition-all ${profile.capital === o.v ? 'border-blue-500 bg-blue-50 shadow-lg' : 'border-gray-200 hover:border-blue-300'}`}>
                    <div className="flex items-center gap-3">
                      <span className="text-2xl">{o.e}</span>
                      <span className="font-semibold">{o.l}</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 2 && (
            <div className="space-y-6">
              <Book className="w-16 h-16 text-purple-500 mx-auto" />
              <h2 className="text-2xl font-bold text-center">{t.exp}</h2>
              <div className="max-w-md mx-auto space-y-4">
                {opts.exp.map(o => (
                  <button key={o.v} onClick={() => setProfile({ ...profile, experience: o.v })} className={`w-full p-4 rounded-lg border-2 transition-all ${profile.experience === o.v ? 'border-purple-500 bg-purple-50 shadow-lg' : 'border-gray-200 hover:border-purple-300'}`}>
                    <div className="flex items-center gap-3">
                      <span className="text-2xl">{o.e}</span>
                      <span className="font-semibold">{o[lang]}</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 3 && (
            <div className="space-y-6">
              <Shield className="w-16 h-16 text-red-500 mx-auto" />
              <h2 className="text-2xl font-bold text-center">{t.risk}</h2>
              <div className="max-w-md mx-auto space-y-4">
                {opts.risk.map(o => (
                  <button key={o.v} onClick={() => setProfile({ ...profile, risk: o.v })} className={`w-full p-4 rounded-lg border-2 transition-all ${profile.risk === o.v ? 'border-red-500 bg-red-50 shadow-lg' : 'border-gray-200 hover:border-red-300'}`}>
                    <div className="flex items-center gap-3">
                      <span className="text-2xl">{o.e}</span>
                      <span className="font-semibold">{o[lang]}</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 4 && (
            <div className="space-y-6">
              <Bell className="w-16 h-16 text-yellow-500 mx-auto" />
              <h2 className="text-2xl font-bold text-center">{t.monitor}</h2>
              <div className="max-w-md mx-auto space-y-4">
                {[{ v: true, e: '👀', l: t.yes }, { v: false, e: '🤖', l: t.no }].map(o => (
                  <button key={String(o.v)} onClick={() => setProfile({ ...profile, monitor: o.v })} className={`w-full p-4 rounded-lg border-2 transition-all ${profile.monitor === o.v ? 'border-yellow-500 bg-yellow-50 shadow-lg' : 'border-gray-200 hover:border-yellow-300'}`}>
                    <div className="flex items-center gap-3">
                      <span className="text-2xl">{o.e}</span>
                      <span className="font-semibold">{o.l}</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 5 && (
            <div className="space-y-6">
              <Zap className="w-16 h-16 text-orange-500 mx-auto" />
              <h2 className="text-2xl font-bold text-center">{t.goals}</h2>
              <div className="max-w-md mx-auto space-y-3">
                {opts.goals.map(o => (
                  <button key={o.v} onClick={() => {
                    const g = profile.goals.includes(o.v) ? profile.goals.filter(x => x !== o.v) : [...profile.goals, o.v];
                    setProfile({ ...profile, goals: g });
                  }} className={`w-full p-4 rounded-lg border-2 transition-all ${profile.goals.includes(o.v) ? 'border-orange-500 bg-orange-50 shadow-lg' : 'border-gray-200 hover:border-orange-300'}`}>
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <span className="text-xl">{o.e}</span>
                        <span className="font-semibold">{o[lang]}</span>
                      </div>
                      {profile.goals.includes(o.v) && <CheckCircle className="w-5 h-5 text-orange-500" />}
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 6 && (
            <div className="space-y-6">
              <CheckCircle className="w-16 h-16 text-green-500 mx-auto" />
              <h2 className="text-3xl font-bold text-center text-green-600">Perfect Match! 🎯</h2>
              <div className="max-w-2xl mx-auto bg-gradient-to-r from-green-50 to-blue-50 p-8 rounded-xl border-2 border-green-300">
                <p className="text-gray-700 mb-4 text-center">
                  AI will analyze the market and select the best strategy for your profile.
                </p>
                <div className="bg-white p-4 rounded-lg">
                  <div className="grid grid-cols-2 gap-2 text-sm">
                    <div>💰 ${profile.capital}</div>
                    <div>📚 {profile.experience}</div>
                    <div>🎯 {profile.risk}</div>
                    <div>⏰ {profile.monitor ? 'Active' : 'Passive'}</div>
                  </div>
                </div>
              </div>
              <div className="text-center space-y-4">
                <button
                  onClick={handleComplete}
                  disabled={loading}
                  className="bg-green-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-600 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 mx-auto"
                >
                  {loading ? (
                    <>
                      <Loader className="w-5 h-5 animate-spin" />
                      {t.starting}
                    </>
                  ) : (
                    <>
                      {t.start} 🚀
                    </>
                  )}
                </button>
                {error && (
                  <div className="mt-4 p-4 bg-red-100 border-2 border-red-300 text-red-700 rounded-lg">
                    <p className="font-semibold">{t.error}:</p>
                    <p className="text-sm">{error}</p>
                    <button
                      onClick={handleComplete}
                      className="mt-2 text-sm underline hover:no-underline"
                    >
                      {t.tryAgain}
                    </button>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>

        {/* Navigation */}
        <div className="flex justify-between mt-6">
          <button onClick={() => setStep(Math.max(0, step - 1))} disabled={step === 0} className="flex items-center gap-2 px-6 py-3 rounded-lg border-2 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50 transition-colors">
            <ArrowLeft className="w-5 h-5" />
            {t.back}
          </button>
          <button onClick={() => setStep(Math.min(steps.length - 1, step + 1))} disabled={!canNext() || step === steps.length - 1} className="flex items-center gap-2 px-6 py-3 rounded-lg bg-blue-500 text-white disabled:opacity-50 disabled:cursor-not-allowed hover:bg-blue-600 transition-colors">
            {t.next}
            <ArrowRight className="w-5 h-5" />
          </button>
        </div>
      </div>
    </div>
  );
}
