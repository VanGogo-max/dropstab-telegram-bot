# ==================== EXCHANGE CONFIGURATION ====================

# KCEX - Spot Trading (Primary Exchange)
KCEX_API_KEY=your_kcex_api_key_here
KCEX_API_SECRET=your_kcex_api_secret_here
KCEX_TESTNET=true

# Hyperliquid - Futures Trading (Arbitrum Network)
HYPERLIQUID_WALLET=0x0000000000000000000000000000000000000000
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_TESTNET=false
# Note: Set to false for mainnet (no testnet tokens available)

# Legacy Exchanges (for Arbitrage Bot only)
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BYBIT_API_KEY=
BYBIT_SECRET=

# ==================== TRADING CONFIGURATION ====================

# Risk Management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=100
MAX_OPEN_POSITIONS=3

# Futures Trading (Hyperliquid)
FUTURES_MAX_LEVERAGE=3
FUTURES_POSITION_RISK=0.02

# Spot Trading (KCEX)
SPOT_MIN_ORDER_SIZE=10

# ==================== BOT CONFIGURATION ====================

# DCA Bot (Dollar Cost Averaging)
DCA_AMOUNT=50
DCA_INTERVAL=24

# Signal Bot (Technical Analysis)
SIGNAL_RSI_OVERSOLD=30
SIGNAL_RSI_OVERBOUGHT=70

# Portfolio Bot (Rebalancing)
PORTFOLIO_REBALANCE_THRESHOLD=0.05

# Trailing Stop Bot
TRAILING_STOP_PERCENT=0.03

# Futures Bot - Turtle Strategy (Hyperliquid)
TURTLE_SYSTEM=2
TURTLE_BREAKOUT_PERIOD=55
TURTLE_EXIT_PERIOD=10
TURTLE_ATR_PERIOD=20
TURTLE_MAX_UNITS=4
TURTLE_UNIT_RISK=0.01

# Grid Bot (KCEX Spot)
GRID_UPPER_PRICE=50000
GRID_LOWER_PRICE=40000
GRID_GRIDS=10
GRID_AMOUNT_PER_GRID=50

# ==================== DATABASE ====================

DATABASE_URL=postgresql://postgres:password@localhost:5432/cryptobot

# ==================== PAYMENT & BUSINESS ====================

# USDT Payment Wallet (Polygon Network)
USDT_WALLET_ADDRESS=0xfee37e7e64d70f37f96c42375131abb57c1481c2
POLYGON_RPC_URL=https://polygon-rpc.com

# Subscription Pricing
SUBSCRIPTION_PRICE=39
REFERRAL_DISCOUNT=0.20
FREE_REFERRALS_NEEDED=5

# ==================== NOTIFICATIONS ====================

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=bot@cryptotradepro.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id

# ==================== MONITORING ====================

REDIS_URL=redis://localhost:6379
LOG_LEVEL=INFO

# Alerts
ALERT_ON_TRADE=true
ALERT_ON_ERROR=true
ALERT_DAILY_REPORT=true

# ==================== SECURITY ====================

JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRATION=3600
API_RATE_LIMIT=100

# ==================== ENVIRONMENT ====================

ENVIRONMENT=development
DEBUG=true
GLOBAL_TESTNET=true

# ==================== KCEX API ENDPOINTS (Update with real values) ====================

# KCEX Base URL (replace with actual)
KCEX_BASE_URL=https://api.kcex.com

# KCEX Endpoints (examples - verify with documentation)
KCEX_BALANCE_ENDPOINT=/api/v1/account/balance
KCEX_ORDER_ENDPOINT=/api/v1/orders
KCEX_TICKER_ENDPOINT=/api/v1/ticker
KCEX_ORDERBOOK_ENDPOINT=/api/v1/orderbook
KCEX_TRADES_ENDPOINT=/api/v1/trades

# ==================== HYPERLIQUID ENDPOINTS ====================

# Hyperliquid Base URLs (Arbitrum Network)
HYPERLIQUID_MAINNET_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_URL=https://api.hyperliquid-testnet.xyz

# Hyperliquid Info Endpoint (POST)
HYPERLIQUID_INFO_ENDPOINT=/info

# Hyperliquid Exchange Endpoint (POST)
HYPERLIQUID_EXCHANGE_ENDPOINT=/exchange

# ==================== NOTES ====================

# KCEX:
# - Verify all endpoint URLs with official KCEX documentation
# - Check authentication method (API Key in header vs signature)
# - Confirm request/response format

# Hyperliquid:
# - Mainnet uses Arbitrum network
# - No testnet tokens available - use small amounts for testing
# - Authentication uses wallet signature
# - All requests are POST with JSON body

# Security:
# - NEVER commit this file with real credentials
# - Use strong passwords for production
# - Rotate API keys regularly
# - Enable IP whitelist on exchanges

# First Time Setup:
# 1. Copy this file to .env
# 2. Fill in your actual API credentials
# 3. Set GLOBAL_TESTNET=true for initial testing
# 4. Verify KCEX endpoints with documentation
# 5. Fund Hyperliquid wallet with small amount
# 6. Test each bot individually before going live
