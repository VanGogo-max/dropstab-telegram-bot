# ==================== EXCHANGE CONFIGURATION ====================

# KCEX - Spot Trading (Primary Exchange)
KCEX_API_KEY=your_kcex_api_key_here
KCEX_API_SECRET=your_kcex_api_secret_here
KCEX_TESTNET=true
KCEX_BASE_URL=https://api.kcex.com
KCEX_BALANCE_ENDPOINT=/api/v1/account/balance
KCEX_ORDER_ENDPOINT=/api/v1/orders
KCEX_TICKER_ENDPOINT=/api/v1/ticker

# Hyperliquid - Futures Trading (Arbitrum Network)
HYPERLIQUID_WALLET=0x0000000000000000000000000000000000000000
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_TESTNET=false
HYPERLIQUID_MAINNET_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_INFO_ENDPOINT=/info
HYPERLIQUID_EXCHANGE_ENDPOINT=/exchange

# dYdX v4 - Leading DeFi Perpetuals
DYDX_WALLET=your_dydx_wallet_address
DYDX_API_KEY=your_dydx_api_key
DYDX_API_SECRET=your_dydx_api_secret
DYDX_MAINNET_URL=https://indexer.dydx.trade
DYDX_TESTNET_URL=https://indexer.v4testnet.dydx.exchange
DYDX_TESTNET=true

# GMX v2 - Arbitrum & Avalanche
GMX_WALLET=0x0000000000000000000000000000000000000000
GMX_PRIVATE_KEY=your_gmx_private_key
GMX_NETWORK=arbitrum
GMX_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
GMX_ARBITRUM_TESTNET_RPC=https://goerli-rollup.arbitrum.io/rpc
GMX_AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
GMX_READER_CONTRACT=0x0000000000000000000000000000000000000000
GMX_TESTNET=false

# Kwenta - Synthetix Perps (Optimism)
KWENTA_WALLET=0x0000000000000000000000000000000000000000
KWENTA_PRIVATE_KEY=your_kwenta_private_key
KWENTA_MAINNET_URL=https://api.kwenta.eth.limo
KWENTA_TESTNET_URL=https://testnet-api.kwenta.eth.limo
KWENTA_TESTNET=false

# Vertex Protocol - Arbitrum Hybrid DEX
VERTEX_WALLET=0x0000000000000000000000000000000000000000
VERTEX_MAINNET_URL=https://gateway.prod.vertexprotocol.com
VERTEX_TESTNET_URL=https://gateway.sepolia-test.vertexprotocol.com
VERTEX_TESTNET=true

# Apex Protocol - Multi-chain Perps
APEX_API_KEY=your_apex_api_key
APEX_API_SECRET=your_apex_api_secret
APEX_MAINNET_URL=https://pro.apex.exchange
APEX_TESTNET_URL=https://pro.apex-test.exchange
APEX_TESTNET=true

# Legacy Exchanges (for Arbitrage Bot only)
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BYBIT_API_KEY=
BYBIT_SECRET=

# ==================== TRADING CONFIGURATION ====================

# Risk Management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=100
MAX_OPEN_POSITIONS=5
MAX_POSITION_PER_EXCHANGE=2

# Futures Trading (All DEXs)
FUTURES_MAX_LEVERAGE=3
FUTURES_POSITION_RISK=0.02
FUTURES_STOP_LOSS_PCT=0.05
FUTURES_TAKE_PROFIT_PCT=0.10

# Spot Trading (KCEX)
SPOT_MIN_ORDER_SIZE=10
SPOT_MAX_SLIPPAGE=0.005

# ==================== ARBITRAGE CONFIGURATION ====================

# Price Arbitrage
PRICE_ARB_MIN_PROFIT_PCT=0.5
PRICE_ARB_MAX_POSITION_SIZE=1000
PRICE_ARB_SCAN_INTERVAL=5
PRICE_ARB_ENABLED=true

# Funding Rate Arbitrage
FUNDING_ARB_MIN_RATE_DIFF=0.01
FUNDING_ARB_MAX_POSITIONS=3
FUNDING_ARB_NOTIONAL_SIZE=2000
FUNDING_ARB_ENABLED=true

# Triangular Arbitrage
TRIANGULAR_ARB_MIN_PROFIT=0.3
TRIANGULAR_ARB_ENABLED=false

# Arbitrage Symbols (comma-separated)
ARB_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,AVAX/USDT,MATIC/USDT

# ==================== BOT CONFIGURATION ====================

# DCA Bot (Dollar Cost Averaging)
DCA_AMOUNT=50
DCA_INTERVAL=24
DCA_ENABLED=true

# Signal Bot (Technical Analysis)
SIGNAL_RSI_OVERSOLD=30
SIGNAL_RSI_OVERBOUGHT=70
SIGNAL_ENABLED=true

# Portfolio Bot (Rebalancing)
PORTFOLIO_REBALANCE_THRESHOLD=0.05
PORTFOLIO_ENABLED=true

# Trailing Stop Bot
TRAILING_STOP_PERCENT=0.03
TRAILING_ENABLED=true

# Futures Bot - Turtle Strategy (Multi-DEX)
TURTLE_SYSTEM=2
TURTLE_BREAKOUT_PERIOD=55
TURTLE_EXIT_PERIOD=10
TURTLE_ATR_PERIOD=20
TURTLE_MAX_UNITS=4
TURTLE_UNIT_RISK=0.01
TURTLE_ENABLED=true

# Grid Bot (KCEX Spot)
GRID_UPPER_PRICE=50000
GRID_LOWER_PRICE=40000
GRID_GRIDS=10
GRID_AMOUNT_PER_GRID=50
GRID_ENABLED=true

# Mean Reversion Bot
MEAN_REVERSION_PERIOD=20
MEAN_REVERSION_STD_DEV=2
MEAN_REVERSION_ENABLED=true

# Trend Master Bot
TREND_EMA_FAST=12
TREND_EMA_SLOW=26
TREND_ENABLED=true

# ==================== DATABASE ====================

DATABASE_URL=postgresql://postgres:password@localhost:5432/cryptobot

# ==================== PAYMENT & BUSINESS ====================

# USDT Payment Wallet (Polygon Network)
USDT_WALLET_ADDRESS=0xfee37e7e64d70f37f96c42375131abb57c1481c2
POLYGON_RPC_URL=https://polygon-rpc.com

# Subscription Pricing
SUBSCRIPTION_PRICE=10
REFERRAL_DISCOUNT=1.00
FREE_REFERRALS_NEEDED=10

# ==================== NOTIFICATIONS ====================

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=bot@cryptotradepro.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id

# ==================== MONITORING ====================

REDIS_URL=redis://localhost:6379
LOG_LEVEL=INFO

# Alerts
ALERT_ON_TRADE=true
ALERT_ON_ERROR=true
ALERT_DAILY_REPORT=true
ALERT_ARBITRAGE_OPPORTUNITY=true
ALERT_FUNDING_RATE_CHANGE=true

# Performance Tracking
TRACK_PNL=true
TRACK_FUNDING_EARNINGS=true
TRACK_ARBITRAGE_PROFITS=true

# ==================== SECURITY ====================

JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRATION=3600
API_RATE_LIMIT=100

# ==================== ENVIRONMENT ====================

ENVIRONMENT=development
DEBUG=true
GLOBAL_TESTNET=true

# ==================== WEB3 CONFIGURATION ====================

# Arbitrum RPC (for Hyperliquid, GMX, Vertex)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_TESTNET_RPC_URL=https://goerli-rollup.arbitrum.io/rpc

# Optimism RPC (for Kwenta)
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_TESTNET_RPC_URL=https://goerli.optimism.io

# Ethereum RPC (backup)
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Gas Settings
MAX_GAS_PRICE_GWEI=50
GAS_LIMIT=500000

# ==================== ADVANCED FEATURES ====================

# Multi-Exchange Smart Order Routing
SMART_ROUTING_ENABLED=true
SMART_ROUTING_MIN_LIQUIDITY=10000

# Cross-Exchange Position Management
HEDGE_POSITIONS=true
AUTO_REBALANCE=true

# API Rate Limiting
RATE_LIMIT_PER_EXCHANGE=10
RATE_LIMIT_WINDOW=1

# ==================== NOTES ====================

# DEX Integration Status:
# ✅ Hyperliquid - Fully integrated (Arbitrum)
# ✅ dYdX v4 - Integrated
# ✅ GMX v2 - Integrated (requires Web3)
# ✅ Kwenta - Integrated (Optimism)
# ✅ Vertex - Integrated (Arbitrum)
# ✅ Apex - Integrated
# ⚠️  KCEX - Verify API endpoints

# Arbitrage Strategies:
# 1. Price Arbitrage - Buy low, sell high across DEXs
# 2. Funding Rate Arbitrage - Earn funding payments
# 3. Triangular Arbitrage - Multi-hop trades

# Security Best Practices:
# - NEVER commit .env file with real credentials
# - Use hardware wallets for large amounts
# - Enable 2FA on all exchanges
# - Start with testnet before mainnet
# - Set position size limits
# - Monitor gas prices on L2s

# Testing Checklist:
# 1. Verify all API endpoints work
# 2. Test with small amounts first
# 3. Check fee structures on each DEX
# 4. Monitor slippage on low-liquidity pairs
# 5. Test arbitrage scanner without execution
# 6. Verify wallet balances across all chains
# 7. Test emergency stop functionality

# Performance Tips:
# - Use WebSocket connections for real-time prices
# - Implement caching for market data
# - Batch API requests where possible
# - Monitor latency to each DEX
# - Use VPS close to exchange servers
