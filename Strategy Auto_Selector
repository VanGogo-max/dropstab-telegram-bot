    def export_recommendation_report(
        self,
        candles: List[Dict],
        user_profile: Dict,
        filepath: str = "strategy_report.json"
    ) -> str:
        """Export full recommendation report"""
        
        market = self.analyze_market_conditions(candles)
        recommendations = self.recommend_strategy(candles, user_profile, top_n=5)
        allocation = self.get_optimal_allocation(candles, user_profile, user_profile['capital'])
        
        report = {
            'timestamp': datetime.now().isoformat(),
            'market_analysis': market,
            'user_profile': user_profile,
            'recommendations': [
                {
                    'strategy': s.value,
                    'score': score,
                    'reasoning': reasoning
                }
                for s, score, reasoning in recommendations
            ],
            'suggested_allocation': {
                s.value: amount for s, amount in allocation.items()
            }
        }
        
        with open(filepath, 'w') as f:
            json.dump(report, f, indent=2)
        
        return filepath


