# ============================================================================
# scripts/maintenance/cleanup.sh - System Cleanup
# ============================================================================
#!/bin/bash

echo "Starting system cleanup..."

# Remove old Docker images
echo "Removing unused Docker images..."
docker image prune -af --filter "until=72h"

# Remove old logs
echo "Cleaning old logs..."
find logs/ -name "*.log" -mtime +30 -delete

# Remove old backups
echo "Cleaning old backups..."
find /backups -name "*.gz" -mtime +30 -delete

# Clean temp files
echo "Cleaning temp files..."
find /tmp -name "trading_*" -mtime +1 -delete

# Vacuum database
echo "Optimizing database..."
docker exec trading_bot_db_prod psql -U postgres -d trading_bot -c "VACUUM ANALYZE;"

# Clean Redis
echo "Optimizing Redis..."
docker exec trading_bot_redis_prod redis-cli BGREWRITEAOF

echo "✅ Cleanup completed"

# Send summary
DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}')
DOCKER_IMAGES=$(docker images | wc -l)

curl -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d "chat_id=${ADMIN_TELEGRAM_CHAT_ID}" \
    -d "text=🧹 System cleanup completed
    
📊 Status:
• Disk usage: ${DISK_USAGE}
• Docker images: ${DOCKER_IMAGES}
• Cleanup time: $(date)"

