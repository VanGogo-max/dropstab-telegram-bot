# ============================================================================
# scripts/alerts/trading_alerts.sh - Trading Alerts Monitor
# ============================================================================
#!/bin/bash

API_URL="http://localhost:3000/api"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN}"
ADMIN_CHAT_ID="${ADMIN_TELEGRAM_CHAT_ID}"

send_telegram() {
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d "chat_id=${ADMIN_CHAT_ID}" \
        -d "text=$1" \
        -d "parse_mode=HTML"
}

# Check daily P&L
check_daily_pnl() {
    local pnl=$(curl -s "${API_URL}/stats/daily-pnl" | jq -r '.pnl')
    
    if (( $(echo "$pnl < -500" | bc -l) )); then
        send_telegram "⚠️ <b>Daily Loss Alert</b>
        
Current P&L: $${pnl}
Action: Review active strategies"
    fi
    
    if (( $(echo "$pnl > 1000" | bc -l) )); then
        send_telegram "🎉 <b>Excellent Performance!</b>
        
Daily P&L: +$${pnl}
Keep up the good work!"
    fi
}

# Check active positions
check_positions() {
    local positions=$(curl -s "${API_URL}/positions/active" | jq '. | length')
    
    if [ "$positions" -gt 20 ]; then
        send_telegram "⚠️ <b>High Position Count</b>
        
Active positions: ${positions}
Consider reducing exposure"
    fi
}

# Check failed trades
check_failed_trades() {
    local failed=$(curl -s "${API_URL}/trades/failed/count/1h" | jq -r '.count')
    
    if [ "$failed" -gt 5 ]; then
        send_telegram "🔴 <b>Multiple Failed Trades</b>
        
Failed in last hour: ${failed}
Check API connection and logs"
    fi
}

# Run checks
check_daily_pnl
check_positions
check_failed_trades

