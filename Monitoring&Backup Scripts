# ============================================================================
# scripts/backup/restore.sh - Restore from Backup
# ============================================================================
#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: $0 <backup_file.tar.gz>"
    exit 1
fi

BACKUP_FILE=$1
RESTORE_DIR="/tmp/restore_$(date +%s)"

echo "⚠️  WARNING: This will restore from backup and overwrite current data!"
read -p "Are you sure? (yes/no): " confirm

if [ "$confirm" != "yes" ]; then
    echo "Restore cancelled"
    exit 0
fi

# Extract backup
mkdir -p "$RESTORE_DIR"
tar -xzf "$BACKUP_FILE" -C "$RESTORE_DIR"

# Stop services
echo "Stopping services..."
docker-compose -f docker-compose.prod.yml stop

# Restore database
echo "Restoring database..."
gunzip < "${RESTORE_DIR}/database.sql.gz" | docker exec -i trading_bot_db_prod psql -U postgres trading_bot

# Restore Redis
echo "Restoring Redis..."
docker cp "${RESTORE_DIR}/redis_dump.rdb" trading_bot_redis_prod:/data/dump.rdb

# Restore configs
echo "Restoring configuration..."
cp "${RESTORE_DIR}/.env.production" .env.production

# Start services
echo "Starting services..."
docker-compose -f docker-compose.prod.yml up -d

echo "✅ Restore completed successfully"

