# ============================================================================
# scripts/health/system_health_check.sh - System Health Monitor
# ============================================================================
#!/bin/bash

TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN}"
ADMIN_CHAT_ID="${ADMIN_TELEGRAM_CHAT_ID}"

send_alert() {
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d "chat_id=${ADMIN_CHAT_ID}" \
        -d "text=$1" \
        -d "parse_mode=HTML"
}

check_container() {
    local container=$1
    if ! docker ps | grep -q "$container"; then
        send_alert "🔴 <b>ALERT:</b> Container <code>$container</code> is DOWN!"
        return 1
    fi
    return 0
}

check_disk_space() {
    local usage=$(df -h / | awk 'NR==2 {print $5}' | sed 's/%//')
    if [ "$usage" -gt 85 ]; then
        send_alert "⚠️ <b>WARNING:</b> Disk usage at ${usage}%"
        return 1
    fi
    return 0
}

check_memory() {
    local usage=$(free | awk 'NR==2 {printf "%.0f", $3/$2 * 100}')
    if [ "$usage" -gt 90 ]; then
        send_alert "⚠️ <b>WARNING:</b> Memory usage at ${usage}%"
        return 1
    fi
    return 0
}

check_api_health() {
    local response=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/health)
    if [ "$response" != "200" ]; then
        send_alert "🔴 <b>ALERT:</b> API health check failed (HTTP $response)"
        return 1
    fi
    return 0
}

check_database() {
    if ! docker exec trading_bot_db_prod pg_isready -U postgres > /dev/null 2>&1; then
        send_alert "🔴 <b>CRITICAL:</b> Database is not responding!"
        return 1
    fi
    return 0
}

# Run all checks
echo "Running health checks..."

FAILED=0

check_container "trading_bot_api_prod" || ((FAILED++))
check_container "trading_bot_frontend_prod" || ((FAILED++))
check_container "trading_bot_db_prod" || ((FAILED++))
check_container "trading_bot_redis_prod" || ((FAILED++))

check_disk_space || ((FAILED++))
check_memory || ((FAILED++))
check_api_health || ((FAILED++))
check_database || ((FAILED++))

if [ $FAILED -eq 0 ]; then
    echo "✅ All health checks passed"
else
    echo "❌ $FAILED health check(s) failed"
    exit 1
fi

