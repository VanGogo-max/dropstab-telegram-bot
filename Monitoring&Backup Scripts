# ============================================================================
# scripts/backup/full_backup.sh - Complete System Backup
# ============================================================================
#!/bin/bash

BACKUP_ROOT="/backups/full"
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="${BACKUP_ROOT}/${DATE}"
LOG_FILE="${BACKUP_ROOT}/backup.log"

mkdir -p "$BACKUP_DIR"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

log "Starting full system backup..."

# 1. Database backup
log "Backing up database..."
docker exec trading_bot_db_prod pg_dump -U postgres trading_bot | gzip > "${BACKUP_DIR}/database.sql.gz"

# 2. Redis backup
log "Backing up Redis..."
docker exec trading_bot_redis_prod redis-cli --rdb /data/dump.rdb SAVE
docker cp trading_bot_redis_prod:/data/dump.rdb "${BACKUP_DIR}/redis_dump.rdb"

# 3. Configuration files
log "Backing up configuration..."
cp .env.production "${BACKUP_DIR}/"
cp -r nginx/ssl "${BACKUP_DIR}/ssl_certs"

# 4. Application logs
log "Backing up logs..."
tar -czf "${BACKUP_DIR}/logs.tar.gz" logs/

# 5. User uploaded files (if any)
if [ -d "uploads" ]; then
    log "Backing up uploads..."
    tar -czf "${BACKUP_DIR}/uploads.tar.gz" uploads/
fi

# Create archive
log "Creating final archive..."
cd "$BACKUP_ROOT"
tar -czf "backup_${DATE}.tar.gz" "${DATE}/"
rm -rf "${DATE}/"

# Upload to cloud (optional)
# rclone copy "backup_${DATE}.tar.gz" remote:backups/

log "Full backup completed: backup_${DATE}.tar.gz"

# Cleanup old backups (keep last 7 days)
find "$BACKUP_ROOT" -name "backup_*.tar.gz" -mtime +7 -delete

